{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@engine": ["packages/engine/src"],
      "@engine/*": ["packages/engine/src/*"],
      "@project-format": ["packages/project-format/src"],
      "@project-format/*": ["packages/project-format/src/*"],
      "@phaser-adapter": ["packages/phaser-adapter/src"],
      "@phaser-adapter/*": ["packages/phaser-adapter/src/*"],
      "@wasm-bridge": ["packages/wasm-bridge/src"],
      "@wasm-bridge/*": ["packages/wasm-bridge/src/*"]
    },
    "types": ["node"]
  },
  "include": ["packages/**/src/**/*.ts", "apps/**/src/**/*.ts", "examples/**/src/**/*.ts", "templates/**/src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vite.prod.config.ts", "config/**/*.ts"],
  "exclude": ["node_modules", "dist", "native"]
}
