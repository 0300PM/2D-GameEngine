{
  "name": "browser2d-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.prod.config.ts && node scripts/release-manifest.mjs",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview --config vite.prod.config.ts",
    "start": "node scripts/hosting-server.mjs --root=dist --port=5175",
    "build:preview": "npm run build && node scripts/hosting-server.mjs --root=dist --port=5175",
    "build:site": "B2D_BASE=/ npm run build",
    "build:subpath": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:scenarios": "node scripts/e2e-scenarios.mjs",
    "test:matrix": "node scripts/e2e-matrix.mjs",
    "test:compat": "node scripts/e2e-compat.mjs",
    "test:hosting": "node scripts/e2e-hosting.mjs",
    "test:e2e": "npm run test:scenarios && npm run test:matrix && npm run test:compat && npm run test:hosting",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "bench": "vitest run --config vitest.bench.config.ts",
    "bench:check": "node scripts/bench-check.mjs",
    "bench:baseline": "node scripts/bench-check.mjs --update",
    "bench:native": "npm run native:bench",
    "bench:native:check": "node scripts/native-bench.mjs --check",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --check",
    "bundle:baseline": "node scripts/bundle-report.mjs --update",
    "native:build": "cmake -S native/core -B build-native -DCMAKE_BUILD_TYPE=Release && cmake --build build-native --config Release",
    "native:test": "cmake -S native/core -B build-native -DCMAKE_BUILD_TYPE=Release && cmake --build build-native --config Release && ctest --test-dir build-native --output-on-failure -C Release",
    "native:bench": "cmake -S native/core -B build-native -DCMAKE_BUILD_TYPE=Release && cmake --build build-native --config Release --target bench_core && node scripts/native-bench.mjs",
    "native:example": "node examples/native-core/run.mjs",
    "examples:native": "node scripts/native-examples.mjs",
    "examples:check": "vitest run --config vitest.config.ts examples",
    "examples:baseline": "node scripts/examples-baseline.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:licenses:check": "node scripts/audit-licenses.mjs --check",
    "versions:check": "node scripts/versions.mjs --check",
    "versions:bump": "node scripts/versions.mjs --bump",
    "release:check": "node scripts/release.mjs --check",
    "release:artifacts": "node scripts/release.mjs --artifacts",
    "release:notes": "node scripts/release.mjs --artifacts --skip-tests",
    "export:game": "node scripts/export-game.mjs",
    "migrate": "node scripts/migrate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test:unit && npm run examples:check && npm run docs:check && npm run versions:check && npm run bench && npm run bench:check && npm run build && npm run bundle:check && npm run audit:licenses:check && npm run release:check",
    "verify:all": "npm run verify && npm run native:test && npm run examples:native && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "3.80.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "playwright": "1.47.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vitest": "^1.6.0"
  }
}
